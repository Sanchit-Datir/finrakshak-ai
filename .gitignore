# FundTrace ingest (see data/README.md "How data is stored"):
# - committed: data/registry/, data/processed/ and the MCA master as 5 parts
#   (data/raw/mca_ogd/company_master.partNof5.csv, each under GitHub's 100 MB limit)
# - not committed: downloaded PDFs/HTML (~800 MB; ED/SFIO need permission to reproduce)
#   and the unsplit MCA CSV — these go to Cloud Storage; data/interim/ is rebuildable
data/interim/
data/raw/*
!data/raw/mca_ogd/
data/raw/mca_ogd/*
!data/raw/mca_ogd/company_master.part*of5.csv

# Graph lab bundles published locally by `node ingest/dist/graphCli.js --web` (source of truth: data/graph)
web/public/graph-lab/

# Playwright output (e2e/)
e2e/test-results/
e2e/playwright-report/
e2e/screenshots/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Saved diagnostics (scripts/collect-logs.sh): local only
logs/

# Synthetic test data (docs/plans/SYNTHETIC_TRANSACTIONS_PLAN.md): rebuilt from the seed with `npm run synth`.
# Only data/synthetic/README.md and manifest.json are tracked.
data/synthetic/*.jsonl
