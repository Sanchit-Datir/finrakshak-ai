rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Every new collection needs an explicit, tested rule.
    match /{document=**} {
      allow read, write: if false;
    }

    // Cloud ingestion (docs/plans/GCP_INGESTION_AGENT_PLAN.md): written only by the pipeline's
    // service accounts (Admin SDK, rules do not apply) and the decideProposal callable. The
    // owner (custom claim `admin`) may read them for the admin page; nobody writes from a client.
    match /ingestRuns/{runId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /ingestReviews/{runId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /agentProposals/{proposalId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    // ingestLocks/{name}: leases between pipeline tasks; no client access (default deny).

    // Agents (docs/plans/AGENTS_PLAN.md): one run envelope per execution, the pattern miner's
    // proposals, and the live pattern library. Written only by the jobs (Admin SDK) and, for the
    // library and the decisions, by the decidePattern callable (B-61). The owner may read them for
    // the admin page; nobody writes from a client, so no agent can approve its own proposal.
    match /agentRuns/{runId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /patternProposals/{proposalId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /riskPatternLibrary/{version} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Synthetic risk scores (docs/plans/REMAINING_WORK.md, W2e): written only by the ingest-score job
    // (Admin SDK) and read only through the getRiskScores callable, which checks the caller's branch.
    // SYNTH data only (B-54); history is never rewritten from a client (B-57).
    match /synthRiskLatest/{loanId} {
      allow read, write: if false;
    }
    match /synthRiskAlerts/{alertId} {
      allow read, write: if false;
    }
    // The risk explainer's sentences (RISK_EXPLAINER_PLAN.md, B-62): beside the alert, never in it
    // (B-57); written only by the ingest-explain job and read only through getRiskScores.
    match /synthRiskExplanations/{alertId} {
      allow read, write: if false;
    }

    // Per-user daily AI call counters. Written only by Cloud Functions (Admin SDK bypasses rules);
    // clients get no access at all.
    match /usage/{usageId} {
      allow read, write: if false;
    }

    // One profile per person (document ID = Firebase Auth user ID): name, role, branch, AI on/off.
    // Written by the owner in the console and read only by Cloud Functions (Admin SDK); the browser
    // asks the getProfile function, so clients get no direct access.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /funds/{fundId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false; // soft-delete only
    }
  }
}
