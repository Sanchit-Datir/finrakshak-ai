# Public Firebase web config (Firebase console -> Project settings -> Your apps). Not secret.
# Leave these empty to run in demo mode: no cloud sign-in and no AI calls.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA Enterprise site key (the key ID; there is no secret). Required against the deployed backend.
VITE_RECAPTCHA_SITE_KEY=
# Functions region; must match functions/src/callable (default asia-south1).
# VITE_FUNCTIONS_REGION=asia-south1
# `npm run dev` only: use the local emulators instead of the real project (never honoured in a build).
# VITE_USE_EMULATORS=true
