{
  "name": "functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "serve": "npm run build && firebase emulators:start --only functions,auth",
    "serve:live": "npm run build && GEMINI_PROVIDER=apikey firebase emulators:start --only functions,auth"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
