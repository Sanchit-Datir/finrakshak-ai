# Demo-video settings. Copy to e2e/demo/.env (git-ignored) and fill in. Values set on the command
# line or in the launcher win over this file. See e2e/demo/README.md for every setting.

# The deployed app.
DEMO_BASE_URL=https://finrakshak-ai.web.app

# account = email + password; quick = the prototype's quick sign-in (no password).
DEMO_SIGN_IN=account
DEMO_EMAIL=manager@gmail.com
# Never commit a password: keep it only in e2e/demo/.env.
DEMO_PASSWORD=

# Only if sign-in reports "app check was not accepted" (Firebase console > App Check > Apps >
# Manage debug tokens).
DEMO_APPCHECK_DEBUG_TOKEN=

# slow | normal | brisk (3–4 minute video) | fast
DEMO_PACE=brisk
# on | off
DEMO_CAPTIONS=on
DEMO_AI=on
DEMO_RECORD=off
# auto (fill the maximised window) or WIDTHxHEIGHT, e.g. 1920x1080
DEMO_VIEWPORT=auto
# chromium | chrome | msedge
DEMO_BROWSER=chromium
DEMO_HOLD_SECONDS=15
